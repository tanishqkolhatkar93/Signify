      "id": "isl_namaste_hello",
      "display_name": "Namaste / Hello",
      "sign_language": "Indian Sign Language (ISL)",
      "category": "Greetings",
      "is_dynamic": false,
      "validation_status": "verified",
      "meaning": "Traditional respectful greeting, hello, or welcome.",
      "english_text": "Hello / Namaste",
      "hindi_text": "नमस्ते / नमस्कार",
      "phonetic_transcription": "nuh-muh-stay",
      "hand_configuration": "Both hands pressed together vertically in front of chest (Anjali Mudra) or single open palm forward wave.",
      "landmark_signature": {
        "thumb_extended": true,
        "index_extended": true,
        "middle_extended": true,
        "ring_extended": true,
        "pinky_extended": true,
        "palm_orientation": "forward_or_together"
      },
      "media": {
