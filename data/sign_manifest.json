        "asset_url": "/assets/signs/isl_namaste.svg",
        "verified_clip_url": "/assets/signs/isl_namaste.mp4",
        "description": "Both palms joined at chest height or open hand held vertically facing the viewer."
      },
      "source": "ISLRTC Dictionary Section 1: Common Greetings",
      "license": "CC-BY-4.0"
    },
