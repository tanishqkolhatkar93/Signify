# Signify Environment Configuration Template
# Duplicate this file to .env for local configuration. Never commit .env.

# Server Configuration
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./signify.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & Provider Settings
# Options: 'mock' (deterministic development fallback) or 'verbx' (live VerbX API)
PROVIDER_MODE=mock

# VerbX / IvishAI Platform Credentials
# Obtain from https://one.verbxeco.com
VERBX_API_KEY=your_verbx_api_key_here
VERBX_API_BASE_URL=https://one.verbxeco.com/api/v1

# Gesture Recognition Hyperparameters
CONFIDENCE_THRESHOLD=0.65
TEMPORAL_SMOOTHING_FRAMES=3
UNKNOWN_SIGN_STABILITY_FRAMES=3

# Privacy & Retention
ALLOW_EVIDENCE_RECORDING=false
REQUIRE_EXPLICIT_CONSENT=true

